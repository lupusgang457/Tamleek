{
  "name": "tamleek-functions",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only auth,functions,firestore,storage",
    "deploy": "firebase deploy --only functions",
    "lint": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --project demo-tamleek --only firestore,storage \"node --test rules_tests/firebase.rules.test.mjs\""
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "file-type": "^21.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.3.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
